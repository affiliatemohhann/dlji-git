{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1180px"
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"em",
				"%"
			]
		}
	},
	"styles": {
		"color": {
			"background": "#ffffff",
			"text": "#111827"
		},
		"typography": {
			"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
			"lineHeight": "1.6"
		}
	}
}
